msgstr "Ripristina come copia"

#: src/spola/gui/window.py:1674
#, python-brace-format
msgid "“{name}” goes back in its place; the next sync uploads it to Koofr."
msgstr ""
"“{name}” torna al suo posto; la prossima sincronizzazione lo porta su Koofr."

#: src/spola/gui/window.py:1684
#, python-brace-format
msgid "Restored: {path}. The next sync uploads it to Koofr."
msgstr "Ripristinato: {path}. La prossima sincronizzazione lo porta su Koofr."

#: src/spola/gui/window.py:1709
#, python-brace-format
msgid "Restore “{name}” from Koofr's trash?"
msgstr "Ripristinare “{name}” dal cestino di Koofr?"

#: src/spola/gui/window.py:1710
msgid ""
"The file goes back in its folder on Koofr, and the next sync brings it here."
msgstr ""
"Il file torna nella sua cartella su Koofr, e la prossima sincronizzazione lo "
"porta qui."

#: src/spola/gui/window.py:1727
msgid "Restored from Koofr's trash: the next sync brings it here."
msgstr ""
"Ripristinato dal cestino di Koofr: la prossima sincronizzazione lo porta qui."

#: src/spola/gui/window.py:1772
#, python-brace-format
msgid ""
"Each copy stays {n} day, then the retention deletes it; Koofr keeps its own "
"previous versions of the files replaced there."
