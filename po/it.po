#: nautilus/spola-nautilus.py:314
msgid "Sync Now with Koofr"
msgstr "Sincronizza ora con Koofr"

#: nautilus/spola-nautilus.py:318 src/spola/window.py:505
msgid "Open on Koofr"
msgstr "Apri su Koofr"

#: nautilus/spola-nautilus.py:321
msgid "Copy Koofr Share Link"
msgstr "Copia il link di condivisione Koofr"

#: src/spola/account.py:51
msgid "Koofr did not answer in time."
msgstr "Koofr non ha risposto in tempo."

#: src/spola/account.py:54
msgid "Koofr refused the e-mail or the app password."
msgstr "Koofr ha rifiutato l'indirizzo e-mail o la password per applicazioni."

#: src/spola/account.py:58
#, python-brace-format
msgid "rclone stopped with error {code}"
msgstr "rclone si è fermato con l'errore {code}"

#: src/spola/add_folder.py:39
msgid "A folder name cannot contain “/”."
msgstr "Il nome di una cartella non può contenere «/»."

#: src/spola/add_folder.py:41
msgid "Koofr does not accept emoji and other special symbols in names."
msgstr "Koofr non accetta emoji e altri simboli speciali nei nomi."

#: src/spola/add_folder.py:43
msgid "There is already a folder with this name."
msgstr "Esiste già una cartella con questo nome."

#: src/spola/add_folder.py:49 src/spola/add_folder.py:126
#: src/spola/window.py:127 src/spola/window.py:149
msgid "Add Folder"
msgstr "Aggiungi cartella"

#: src/spola/add_folder.py:75
msgid "The app password is not in the keyring: sign in again."
msgstr "La password per applicazioni non è nel portachiavi: accedi di nuovo."

#: src/spola/add_folder.py:85 src/spola/add_folder.py:357
#: src/spola/window.py:270 src/spola/window.py:631 src/spola/window.py:736
#: src/spola/window.py:892
msgid "Cancel"
msgstr "Annulla"

#: src/spola/add_folder.py:88 src/spola/add_folder.py:262
msgid "Add"
msgstr "Aggiungi"

#: src/spola/add_folder.py:95
msgid ""
"The two folders are kept identical in both directions. Before anything is "
"copied, a preview shows what the first alignment does."
msgstr ""
"Le due cartelle restano identiche in entrambe le direzioni. Prima di copiare "
"qualsiasi cosa, un'anteprima ti mostra cosa fa il primo allineamento."

#: src/spola/add_folder.py:98
msgid "On This Computer"
msgstr "Su questo computer"

#: src/spola/add_folder.py:99
msgid "Folder"
msgstr "Cartella"

#: src/spola/add_folder.py:99
msgid "None chosen"
msgstr "Nessuna scelta"

#: src/spola/add_folder.py:100
msgid "Choose…"
msgstr "Scegli…"

#: src/spola/add_folder.py:107
msgid "On Koofr"
msgstr "Su Koofr"

#: src/spola/add_folder.py:108
msgid "Looking for matching folders…"
msgstr "Cerco le cartelle corrispondenti…"

#: src/spola/add_folder.py:111 src/spola/add_folder.py:202
msgid "Other Folder"
msgstr "Un'altra cartella"

#: src/spola/add_folder.py:111 src/spola/add_folder.py:203
msgid "Browse the folders on Koofr"
msgstr "Sfoglia le cartelle su Koofr"

#: src/spola/add_folder.py:123
msgid "Cannot add this folder"
msgstr "Non si può aggiungere questa cartella"

#: src/spola/add_folder.py:129
msgid "Choose a Folder"
msgstr "Scegli una cartella"

#: src/spola/add_folder.py:162
msgid "Cannot reach Koofr"
msgstr "Koofr non è raggiungibile"

#: src/spola/add_folder.py:203
msgid "Chosen on Koofr"
msgstr "Scelta su Koofr"

#: src/spola/add_folder.py:233 src/spola/cli.py:85 src/spola/cli.py:214
#: src/spola/window.py:955
#, python-brace-format
msgid "…and {n} more"
msgstr "…e altri {n}"

#: src/spola/add_folder.py:252
msgid "Checking names…"
msgstr "Controllo dei nomi…"

#: src/spola/add_folder.py:290
msgid "Choose"
msgstr "Scegli"

#: src/spola/add_folder.py:300
msgid "Cannot Open This Folder"
msgstr "Impossibile aprire questa cartella"

#: src/spola/add_folder.py:301 src/spola/window.py:409
msgid "Try Again"
msgstr "Riprova"

#: src/spola/add_folder.py:338
msgid "No folders inside"
msgstr "Nessuna cartella qui dentro"

#: src/spola/add_folder.py:342
msgid "New Folder…"
msgstr "Nuova cartella…"

#: src/spola/add_folder.py:351
msgid "Name"
msgstr "Nome"

#: src/spola/add_folder.py:354
#, python-brace-format
msgid "A new empty folder in {place} on Koofr."
msgstr "Una nuova cartella vuota in {place} su Koofr."

#: src/spola/add_folder.py:355
msgid "A new empty folder at the top level of Koofr."
msgstr "Una nuova cartella vuota al primo livello di Koofr."

#: src/spola/add_folder.py:356
msgid "New Folder"
msgstr "Nuova cartella"

#: src/spola/add_folder.py:358
msgid "Create"
msgstr "Crea"

#: src/spola/app.py:34
msgid "Start without opening the window"
msgstr "Avvia senza aprire la finestra"

#: src/spola/app.py:188 src/spola/engine.py:327
msgid "Not signed in to Koofr"
msgstr "Accesso a Koofr non effettuato"

#: src/spola/app.py:200
msgid "Transferring Now"
msgstr "In trasferimento"

#: src/spola/app.py:201
msgid "Recently Synced Files"
msgstr "File sincronizzati di recente"

#: src/spola/app.py:202
msgid "No recently synced files"
msgstr "Nessun file sincronizzato di recente"

#: src/spola/app.py:208 src/spola/window.py:579
msgid "Sync Now"
msgstr "Sincronizza ora"

#: src/spola/app.py:209 src/spola/window.py:427
msgid "Resume"
msgstr "Riprendi"

#: src/spola/app.py:209
msgid "Pause"
msgstr "Metti in pausa"

#: src/spola/app.py:210
msgid "Open Spola"
msgstr "Apri Spola"

#: src/spola/app.py:212 src/spola/window.py:138
msgid "Quit"
msgstr "Esci"

#: src/spola/app.py:264 src/spola/window.py:397
#, python-brace-format
msgid "Conflicts in “{name}”"
msgstr "Conflitti in «{name}»"

#: src/spola/app.py:265 src/spola/window.py:395
#, python-brace-format
msgid "“{name}” is waiting for your confirmation"
msgstr "«{name}» aspetta una tua conferma"

#: src/spola/app.py:266 src/spola/window.py:394
#, python-brace-format
msgid "“{name}” needs a repair"
msgstr "«{name}» va riparata"

#: src/spola/app.py:267 src/spola/window.py:399
#, python-brace-format
msgid "“{name}” cannot be synced"
msgstr "«{name}» non si riesce a sincronizzare"

#: src/spola/app.py:268 src/spola/window.py:398
#, python-brace-format
msgid "Some files in “{name}” are not synced"
msgstr "Alcuni file di «{name}» non sono sincronizzati"

#: src/spola/app.py:286
msgid "Stopping…"
msgstr "Arresto in corso…"

#: src/spola/autostart.py:45
msgid "Keep your folders in sync with Koofr"
msgstr "Sincronizza le tue cartelle con Koofr"

#: src/spola/autostart.py:62
msgid "Spola keeps your folders in sync with Koofr in the background."
msgstr "Spola tiene sincronizzate le tue cartelle con Koofr in background."

#: src/spola/cli.py:69 src/spola/window.py:930
msgid "Copied to Koofr"
msgstr "Copiati su Koofr"

#: src/spola/cli.py:70 src/spola/window.py:931
msgid "Copied to this computer"
msgstr "Copiati su questo computer"

#: src/spola/cli.py:71 src/spola/window.py:932
msgid ""
"Replaced here by the newer Koofr version (the old one goes to the backup)"
msgstr ""
"Sostituiti qui dalla versione più recente su Koofr (la vecchia va nel backup)"

#: src/spola/cli.py:72 src/spola/window.py:934
msgid "Deleted here (moved to Spola's backup)"
msgstr "Eliminati qui (spostati nel backup di Spola)"

#: src/spola/cli.py:73 src/spola/window.py:935
msgid "Deleted on Koofr"
msgstr "Eliminati su Koofr"

#: src/spola/cli.py:74 src/spola/window.py:936
msgid "Changed on both sides: both versions are kept"
msgstr "Cambiati da entrambe le parti: restano entrambe le versioni"

#: src/spola/cli.py:75 src/spola/window.py:937
msgid "Left out: Koofr does not accept these names (rename them to sync them)"
msgstr ""
"Lasciati fuori: Koofr non accetta questi nomi (rinominali per sincronizzarli)"

#: src/spola/cli.py:78 src/spola/window.py:941
msgid "Nothing to do: the two folders already match."
msgstr "Niente da fare: le due cartelle sono già allineate."

#: src/spola/cli.py:81 src/spola/ui.py:130 src/spola/window.py:947
#, python-brace-format
msgid "{n} file"
msgid_plural "{n} files"
msgstr[0] "{n} file"
msgstr[1] "{n} file"

#: src/spola/cli.py:112 src/spola/engine.py:531
msgid "This folder is being synced by another Spola process."
msgstr ""
"Questa cartella è già in sincronizzazione da un altro processo di Spola."

#: src/spola/cli.py:117
msgid ""
"Stopping (the current transfers finish first; press Ctrl+C again to stop at "
"once)…"
msgstr ""
"Arresto in corso (prima finiscono i trasferimenti in corso; premi di nuovo "
"Ctrl+C per fermare subito)…"

#: src/spola/cli.py:139
msgid "Keep folders in sync with Koofr."
msgstr "Sincronizza le cartelle con Koofr."

#: src/spola/cli.py:142
msgid "sign in with your Koofr e-mail and an app password"
msgstr "accedi con la tua e-mail di Koofr e una password per applicazioni"

#: src/spola/cli.py:143
msgid "remove the app password from the keyring"
msgstr "rimuovi la password per applicazioni dal portachiavi"

#: src/spola/cli.py:144
msgid "show the folder pairs"
msgstr "mostra le coppie di cartelle"

#: src/spola/cli.py:145
msgid "add a folder pair"
msgstr "aggiungi una coppia di cartelle"

#: src/spola/cli.py:148
msgid "forget a folder pair (no file is deleted)"
msgstr "dimentica una coppia di cartelle (nessun file viene eliminato)"

#: src/spola/cli.py:150
msgid "take over the folder pairs of Koofr Desktop (stopped first)"
msgstr "rileva le coppie di cartelle di Koofr Desktop (prima va fermato)"

#: src/spola/cli.py:151
msgid "Koofr Desktop's config.json (default: ~/.koofr/config.json)"
msgstr "il config.json di Koofr Desktop (predefinito: ~/.koofr/config.json)"

#: src/spola/cli.py:152
msgid "show what the next sync would do"
msgstr "mostra cosa farebbe la prossima sincronizzazione"

#: src/spola/cli.py:153
msgid "first alignment of a new pair (preview, then asks)"
msgstr ""
"primo allineamento di una nuova coppia (anteprima, poi chiede conferma)"

#: src/spola/cli.py:154
msgid "new alignment after a critical error (preview, then asks)"
msgstr ""
"nuovo allineamento dopo un errore critico (anteprima, poi chiede conferma)"

#: src/spola/cli.py:155
msgid "sync a pair now"
msgstr "sincronizza subito una coppia"

#: src/spola/cli.py:160
msgid "go past the safety checks (only after looking at the preview)"
msgstr "supera i controlli di sicurezza (solo dopo aver guardato l'anteprima)"

#: src/spola/cli.py:169 src/spola/engine.py:507 src/spola/window.py:231
msgid "rclone was not found."
msgstr "rclone non è stato trovato."

#: src/spola/cli.py:172
msgid "Spola is running: use its window, or quit it first."
msgstr "Spola è in esecuzione: usa la sua finestra, oppure chiudila prima."

#: src/spola/cli.py:176
#, python-brace-format
msgid "Create an app password at {url}"
msgstr "Crea una password per applicazioni su {url}"

#: src/spola/cli.py:177
msgid "Koofr e-mail: "
msgstr "E-mail di Koofr: "

#: src/spola/cli.py:178
msgid "App password: "
msgstr "Password per applicazioni: "

#: src/spola/cli.py:191
#, python-brace-format
msgid "Signed in. Free space: {free} GB"
msgstr "Accesso effettuato. Spazio libero: {free} GB"

#: src/spola/cli.py:198
msgid "Signed out."
msgstr "Disconnesso."

#: src/spola/cli.py:209 src/spola/cli.py:223
msgid "paused"
msgstr "in pausa"

#: src/spola/cli.py:209
msgid "to align"
msgstr "da allineare"

#: src/spola/cli.py:217
#, python-brace-format
msgid "Added {n} pairs. Next: spola align <pair> for each, preview first."
msgstr ""
"Aggiunte {n} coppie. Prossimo passo: spola align <coppia> per ciascuna, "
"prima l'anteprima."

#: src/spola/cli.py:221
#, python-brace-format
msgid "Account: {user}"
msgstr "Account: {user}"

#: src/spola/cli.py:223
msgid "active"
msgstr "attiva"

#: src/spola/cli.py:223
msgid "first alignment to confirm"
msgstr "primo allineamento da confermare"

#: src/spola/cli.py:228
#, python-brace-format
msgid "{n} entries in the last synced state"
msgstr "{n} voci nell'ultimo stato sincronizzato"

#: src/spola/cli.py:237 src/spola/migrate.py:59
msgid "Choose a folder on Koofr, not the whole Koofr storage."
msgstr "Scegli una cartella su Koofr, non tutto lo spazio di Koofr."

#: src/spola/cli.py:247
#, python-brace-format
msgid "Added [{id}]. Next: spola align {id}"
msgstr "Aggiunta [{id}]. Prossimo passo: spola align {id}"

#: src/spola/cli.py:252
#, python-brace-format
msgid "No such pair: {key}"
msgstr "Coppia inesistente: {key}"

#: src/spola/cli.py:257
msgid "Removed. No file was deleted."
msgstr "Rimossa. Nessun file è stato eliminato."

#: src/spola/cli.py:262
msgid "Not signed in: run 'spola login'."
msgstr "Accesso non effettuato: esegui 'spola login'."

#: src/spola/cli.py:273
msgid "This pair is already aligned."
msgstr "Questa coppia è già allineata."

#: src/spola/cli.py:280
msgid "Go ahead?"
msgstr "Procedo?"

#: src/spola/cli.py:288
msgid "Aligned."
msgstr "Allineata."

#: src/spola/cli.py:300
msgid "Go past the safety checks and do this?"
msgstr "Supero i controlli di sicurezza e procedo?"

#: src/spola/cli.py:307
#, python-brace-format
msgid ""
"Look at the preview (spola preview {id} --force) and confirm with: spola "
"sync {id} --force"
msgstr ""
"Guarda l'anteprima (spola preview {id} --force) e conferma con: spola sync "
"{id} --force"

#: src/spola/cli.py:310
#, python-brace-format
msgid "Repair with: spola repair {id}"
msgstr "Ripara con: spola repair {id}"

#: src/spola/conflicts.py:97
msgid "Too many files with that name."
msgstr "Troppi file con quel nome."

#: src/spola/conflicts.py:117 src/spola/conflicts.py:136
msgid "That version is no longer there."
msgstr "Quella versione non c'è più."

#: src/spola/conflicts.py:119
#, python-brace-format
msgid "A file named “{name}” exists now: rename it first."
msgstr "Adesso esiste un file di nome «{name}»: prima rinominalo."

#: src/spola/conflicts.py:127
#, python-brace-format
msgid "{stem} (this computer {date}){ext}"
msgstr "{stem} (questo computer {date}){ext}"

#: src/spola/conflicts.py:130
#, python-brace-format
msgid "{stem} (Koofr {date}){ext}"
msgstr "{stem} (Koofr {date}){ext}"

#: src/spola/engine.py:329
msgid "rclone is missing"
msgstr "manca rclone"

#: src/spola/engine.py:331 src/spola/engine.py:366 src/spola/ui.py:77
#: src/spola/window.py:427 src/spola/window.py:431
msgid "Paused"
msgstr "In pausa"

#: src/spola/engine.py:333
msgid "Offline"
msgstr "Non in linea"

#: src/spola/engine.py:335
msgid "Paused on a metered connection"
msgstr "In pausa su una connessione a consumo"

#: src/spola/engine.py:337
msgid "Paused in power saver mode"
msgstr "In pausa con il risparmio energetico"

#: src/spola/engine.py:368 src/spola/ui.py:78
msgid "First alignment to confirm"
msgstr "Primo allineamento da confermare"

#: src/spola/engine.py:434 src/spola/engine.py:437
msgid "The exclusions changed"
msgstr "Le esclusioni sono cambiate"

#: src/spola/engine.py:457
msgid "Wait for the current sync to finish."
msgstr "Aspetta che finisca la sincronizzazione in corso."

#: src/spola/engine.py:505
msgid "Sign in to Koofr first."
msgstr "Prima accedi a Koofr."

#: src/spola/engine.py:542
msgid "Syncing with Koofr"
msgstr "Sincronizzazione con Koofr"

#: src/spola/engine.py:543
msgid "Preparing the preview…"
msgstr "Preparazione dell'anteprima…"

#: src/spola/engine.py:543
msgid "Syncing…"
msgstr "Sincronizzazione…"

#: src/spola/engine.py:610
#, python-brace-format
msgid "{n} file is not synced: Koofr does not accept its name."
msgid_plural "{n} files are not synced: Koofr does not accept their names."
msgstr[0] "{n} file non è sincronizzato: Koofr non accetta il suo nome."
msgstr[1] "{n} file non sono sincronizzati: Koofr non accetta i loro nomi."

#: src/spola/engine.py:635
#, python-brace-format
msgid "{n} file was changed both here and on Koofr: both versions are kept."
msgid_plural ""
"{n} files were changed both here and on Koofr: both versions are kept."
msgstr[0] ""
"{n} file è cambiato sia qui sia su Koofr: restano entrambe le versioni."
msgstr[1] ""
"{n} file sono cambiati sia qui sia su Koofr: restano entrambe le versioni."

#: src/spola/engine.py:653
msgid "The sync stopped with an error."
msgstr "La sincronizzazione si è fermata per un errore."

#: src/spola/engine.py:655
#, python-brace-format
msgid "Koofr cannot be reached right now: trying again in {n} min."
msgstr ""
"Koofr non è raggiungibile in questo momento: nuovo tentativo tra {n} min."

#. TRANSLATORS: goes into file names, e.g. report.conflict-local-2026-10-10-1.odt;
#. use letters and "-" only
#: src/spola/jobs.py:36
msgid "conflict-local"
msgstr "conflitto-locale"

#: src/spola/jobs.py:36
msgid "conflict-koofr"
msgstr "conflitto-koofr"

#: src/spola/migrate.py:45
msgid "Koofr Desktop is running or set to start at login: stop it first."
msgstr ""
"Koofr Desktop è in esecuzione o impostato per avviarsi all'accesso: prima "
"fermalo."

#: src/spola/migrate.py:55
msgid "already in Spola"
msgstr "già in Spola"

#: src/spola/preflight.py:61
msgid "The folder path must be absolute."
msgstr "Il percorso della cartella deve essere assoluto."

#: src/spola/preflight.py:63
msgid "The folder is a symbolic link: choose the folder it points to."
msgstr ""
"La cartella è un collegamento simbolico: scegli la cartella a cui punta."

#: src/spola/preflight.py:66
msgid "The folder does not exist."
msgstr "La cartella non esiste."

#: src/spola/preflight.py:70
msgid "This folder contains your whole home folder: choose a folder inside it."
msgstr ""
"Questa cartella contiene tutta la tua cartella home: scegli una cartella al "
"suo interno."

#: src/spola/preflight.py:74
msgid ""
"This folder holds settings and data of the system or of other apps and "
"cannot be synced."
msgstr ""
"Questa cartella contiene impostazioni e dati del sistema o di altre app e "
"non si può sincronizzare."

#: src/spola/preflight.py:78
msgid ""
"Only folders inside your home folder or on removable drives can be synced."
msgstr ""
"Si possono sincronizzare solo cartelle dentro la tua home o su dischi "
"rimovibili."

#: src/spola/preflight.py:91
msgid "This folder overlaps with the folder of another pair."
msgstr "Questa cartella si sovrappone alla cartella di un'altra coppia."

#: src/spola/preflight.py:94
msgid "This Koofr folder overlaps with the Koofr folder of another pair."
msgstr ""
"Questa cartella di Koofr si sovrappone alla cartella di Koofr di un'altra "
"coppia."

#: src/spola/preflight.py:151
msgid ""
"Koofr Desktop is syncing this folder. Pause or remove that sync in Koofr "
"Desktop first."
msgstr ""
"Koofr Desktop sta sincronizzando questa cartella. Prima metti in pausa o "
"rimuovi quella sincronizzazione in Koofr Desktop."

#: src/spola/preflight.py:180
msgid "The local folder is missing. If it is on a drive, connect it."
msgstr "La cartella locale non c'è. Se è su un disco, collegalo."

#: src/spola/preflight.py:182 src/spola/preflight.py:192
#, python-brace-format
msgid "The local folder cannot be read: {error}"
msgstr "Non si riesce a leggere la cartella locale: {error}"

#: src/spola/preflight.py:184
msgid "The local path is no longer a folder."
msgstr "Il percorso locale non è più una cartella."

#: src/spola/preflight.py:185
msgid ""
"The local folder was replaced by a different one (another drive, or deleted "
"and recreated). Sync is stopped to protect your files."
msgstr ""
"La cartella locale è stata sostituita da un'altra (un altro disco, oppure "
"eliminata e ricreata). La sincronizzazione è ferma per proteggere i tuoi "
"file."

#: src/spola/preflight.py:203
#, python-brace-format
msgid "The local folder cannot be written: {error}"
msgstr "Non si riesce a scrivere nella cartella locale: {error}"

#: src/spola/preflight.py:233 src/spola/preflight.py:299
msgid "Koofr does not accept emoji and similar characters in names."
msgstr "Koofr non accetta emoji e caratteri simili nei nomi."

#: src/spola/preflight.py:235
msgid "The name is longer than the 255 characters Koofr accepts."
msgstr "Il nome supera i 255 caratteri che Koofr accetta."

#: src/spola/preflight.py:237 src/spola/preflight.py:300
msgid "The path is longer than the 1023 characters Koofr accepts."
msgstr "Il percorso supera i 1023 caratteri che Koofr accetta."

#: src/spola/preflight.py:240
#, python-brace-format
msgid ""
"Koofr does not tell upper and lower case apart: this name collides with "
"“{other}”."
msgstr ""
"Koofr non distingue maiuscole e minuscole: questo nome si scontra con "
"«{other}»."

#: src/spola/preflight.py:297
#, python-brace-format
msgid ""
"Koofr does not tell upper and lower case apart: “{other}” is synced in its "
"place."
msgstr ""
"Koofr non distingue maiuscole e minuscole: al suo posto viene sincronizzato "
"«{other}»."

#: src/spola/preflight.py:301
msgid ""
"Another name in the same folder differs only in upper and lower case, and "
"Koofr does not tell them apart."
msgstr ""
"Un altro nome nella stessa cartella differisce solo per maiuscole e "
"minuscole, e Koofr non le distingue."

