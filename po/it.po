#: src/spola/app/conflicts.py:128
msgid "Both versions are kept, renamed."
msgstr "Restano entrambe le versioni, rinominate."

#: src/spola/app/conflicts.py:131
msgid "This computer's version is no longer there: choose yourself."
msgstr "La versione di questo computer non c'è più: scegli tu."

#: src/spola/app/conflicts.py:132
msgid "This computer's version is kept."
msgstr "Resta la versione di questo computer."

#: src/spola/app/conflicts.py:135
msgid "Koofr's version is no longer there: choose yourself."
msgstr "La versione di Koofr non c'è più: scegli tu."

#: src/spola/app/conflicts.py:136
msgid "Koofr's version is kept."
msgstr "Resta la versione di Koofr."

#: src/spola/app/conflicts.py:140
msgid "Only one version is left: choose yourself."
msgstr "È rimasta una sola versione: scegli tu."

#: src/spola/app/conflicts.py:143
msgid "Both versions have the same modification time: choose yourself."
msgstr "Le due versioni hanno la stessa data di modifica: scegli tu."

#: src/spola/app/conflicts.py:145
#, python-brace-format
msgid "This computer's version is newer, by {time}."
msgstr "La versione di questo computer è più recente di {time}."

#: src/spola/app/conflicts.py:146
#, python-brace-format
msgid "Koofr's version is newer, by {time}."
msgstr "La versione di Koofr è più recente di {time}."

#: src/spola/app/conflicts.py:154
msgid "Too many files with that name."
msgstr "Troppi file con quel nome."

#: src/spola/app/conflicts.py:162
#, python-brace-format
msgid "“{name}” could not be moved to the wastebasket: {error}"
msgstr "Impossibile spostare “{name}” nel cestino: {error}"

#: src/spola/app/conflicts.py:178 src/spola/app/conflicts.py:197
msgid "That version is no longer there."
msgstr "Quella versione non c'è più."

#: src/spola/app/conflicts.py:180 src/spola/app/engine.py:1602
#, python-brace-format
msgid "A file named “{name}” exists now: rename it first."
msgstr "Adesso esiste un file di nome «{name}»: prima rinominalo."

#: src/spola/app/conflicts.py:188
#, python-brace-format
msgid "{stem} (this computer {date}){ext}"
msgstr "{stem} (questo computer {date}){ext}"

#: src/spola/app/conflicts.py:191
