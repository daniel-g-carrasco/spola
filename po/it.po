msgstr "{stem} (Koofr {date}){ext}"

#: src/spola/app/dbus_service.py:328 src/spola/app/dbus_service.py:335
#: src/spola/gui/application.py:355
#, python-brace-format
msgid "“{name}” is not in a folder synced with Koofr."
msgstr "«{name}» non è in una cartella sincronizzata con Koofr."

#: src/spola/app/dbus_service.py:337 src/spola/app/engine.py:839
#: src/spola/gui/application.py:390 src/spola/gui/application.py:519
msgid "Not signed in to Koofr"
msgstr "Accesso a Koofr non effettuato"

#: src/spola/app/dbus_service.py:360
msgid "Sharing could not be checked. Open Share… to try again."
msgstr ""
"Non è stato possibile verificare la condivisione. Apri «Condividi…» per "
"riprovare."

#: src/spola/app/dbus_service.py:364
msgid "The Koofr account changed. Open Share… again."
msgstr "L’account Koofr è cambiato. Apri di nuovo «Condividi…»."

#: src/spola/app/dbus_service.py:371
msgid ""
"Open Share… to explicitly create or manage a link. No usable unprotected "
"link exists."
msgstr ""
"Apri «Condividi…» per creare o gestire un link. Non esiste un link "
"utilizzabile senza password."

#: src/spola/app/engine.py:159
#, python-brace-format
msgid ""
"Not enough space on this computer: the sync would download {need}, and "
"{free} is free"
msgstr ""
"Spazio insufficiente su questo computer: la sincronizzazione scaricherebbe "
"{need}, e lo spazio libero è {free}"

#: src/spola/app/engine.py:162
#, python-brace-format
msgid ""
"The disk of this folder is nearly full ({free} free): free some space, and "
"the sync goes on"
msgstr ""
"Il disco di questa cartella è quasi pieno ({free} liberi): libera un po' di "
"spazio e la sincronizzazione riprende"

#: src/spola/app/engine.py:165
#, python-brace-format
msgid ""
"The disk holding Spola's own files is nearly full ({free} free): free some "
"space, and the sync goes on"
msgstr ""
"Il disco che contiene i file di Spola è quasi pieno ({free} liberi): libera "
"un po' di spazio e la sincronizzazione riprende"

#: src/spola/app/engine.py:246
#, python-brace-format
msgid ""
"The public link to “{old}” no longer works. Share “{new}” again to make a "
"new one: its address will be different."
msgstr ""
"Il link pubblico di «{old}» non funziona più. Condividi di nuovo «{new}» per "
"crearne uno: avrà un indirizzo diverso."

#: src/spola/app/engine.py:248
#, python-brace-format
msgid ""
"The public link to “{old}” no longer works: Koofr removed it with what it "
"pointed to."
msgstr ""
"Il link pubblico di «{old}» non funziona più: Koofr l'ha tolto insieme a ciò "
"a cui puntava."

#: src/spola/app/engine.py:258
#, python-brace-format
msgid "{n} of {total} files are gone from this computer at once"
msgstr "{n} file su {total} spariti da questo computer tutti insieme"

#: src/spola/app/engine.py:259
#, python-brace-format
msgid "{n} of {total} files are gone from Koofr at once"
msgstr "{n} file su {total} spariti da Koofr tutti insieme"

#: src/spola/app/engine.py:261
msgid "Every file of one side changed at once"
msgstr "Tutti i file di un lato sono cambiati insieme"

#: src/spola/app/engine.py:268
msgid ""
"The folder is no longer on Koofr: deleted or moved there. The files here are "
"untouched."
msgstr ""
"La cartella non c'è più su Koofr: è stata eliminata o spostata lì. I file "
"qui sono intatti."

#: src/spola/app/engine.py:269
msgid ""
"The folder on Koofr is empty: everything in it was deleted there. The files "
"here are untouched."
msgstr ""
"La cartella su Koofr è vuota: tutto quello che conteneva è stato eliminato "
"lì. I file qui sono intatti."

#: src/spola/app/engine.py:271
msgid ""
"The folder on this computer is empty: everything in it was deleted or moved. "
"The files on Koofr are untouched."
msgstr ""
"La cartella su questo computer è vuota: tutto quello che conteneva è stato "
"eliminato o spostato. I file su Koofr sono intatti."

#: src/spola/app/engine.py:516 src/spola/app/engine.py:935
#: src/spola/app/engine.py:1142
msgid "This folder is no longer synced."
msgstr "Questa cartella non è più sincronizzata."

#: src/spola/app/engine.py:518 src/spola/app/engine.py:1623
msgid "Wait for the current sync to finish."
msgstr "Aspetta che finisca la sincronizzazione in corso."

#: src/spola/app/engine.py:657 src/spola/cli.py:109
#, python-brace-format
msgid "The settings could not be saved: {error}"
msgstr "Impossibile salvare le impostazioni: {error}"

#: src/spola/app/engine.py:790 src/spola/app/engine.py:1203
#: src/spola/app/engine.py:1332 src/spola/app/engine.py:1501
#: src/spola/app/engine.py:1747 src/spola/app/engine.py:1957
#: src/spola/gui/window.py:262
msgid "Sign in to Koofr first."
msgstr "Prima accedi a Koofr."

#: src/spola/app/engine.py:841
msgid "rclone is missing"
msgstr "manca rclone"

#: src/spola/app/engine.py:843 src/spola/app/engine.py:882
#: src/spola/gui/ui.py:84 src/spola/gui/window.py:723
#: src/spola/gui/window.py:727
msgid "Paused"
msgstr "In pausa"

#: src/spola/app/engine.py:845
msgid "Offline"
msgstr "Non in linea"

#: src/spola/app/engine.py:847
msgid "Paused on a metered connection"
msgstr "In pausa su una connessione a consumo"

#: src/spola/app/engine.py:849
msgid "Paused in power saver mode"
msgstr "In pausa con il risparmio energetico"

#: src/spola/app/engine.py:884 src/spola/gui/ui.py:85
msgid "First alignment to confirm"
msgstr "Primo allineamento da confermare"

#: src/spola/app/engine.py:984
#, python-brace-format
msgid "Syncing from the state known at {time}"
msgstr "Sincronizzazione dallo stato noto alle {time}"

#: src/spola/app/engine.py:1012 src/spola/app/engine.py:1055
#: src/spola/app/engine.py:1752 src/spola/app/engine.py:1898
msgid "Stopped."
msgstr "Fermato."

#: src/spola/app/engine.py:1057 src/spola/gui/window.py:2500
msgid "The preview failed"
msgstr "L'anteprima non è riuscita"

#: src/spola/app/engine.py:1078
#, python-brace-format
msgid "{n} difference between this computer and Koofr"
msgid_plural "{n} differences between this computer and Koofr"
msgstr[0] "{n} differenza tra questo computer e Koofr"
msgstr[1] "{n} differenze tra questo computer e Koofr"

#: src/spola/app/engine.py:1084 src/spola/gui/window.py:1891
#, python-brace-format
msgid "{n} file, the same on both sides"
msgid_plural "{n} files, the same on both sides"
msgstr[0] "{n} file, uguale sui due lati"
msgstr[1] "{n} file, uguali sui due lati"

#: src/spola/app/engine.py:1091 src/spola/cli.py:93
#: src/spola/gui/window.py:2531
msgid "Nothing to do: the two folders already match."
msgstr "Niente da fare: le due cartelle sono già allineate."

#: src/spola/app/engine.py:1148
msgid "The preview is no longer current."
msgstr "L'anteprima non è più attuale."

#: src/spola/app/engine.py:1271
msgid "Koofr is taking longer to respond. Retrying…"
msgstr "Koofr sta impiegando più tempo a rispondere. Nuovo tentativo…"

#: src/spola/app/engine.py:1278
msgid ""
"The trash changed during the search. Search again to refresh the results."
msgstr ""
"Il cestino è cambiato durante la ricerca. Ripeti la ricerca per aggiornare i "
"risultati."

#: src/spola/app/engine.py:1321
msgid "The trash is large. Continue searching to read the remaining files."
msgstr ""
"Il cestino è molto grande. Continua la ricerca per leggere i file rimanenti."

#: src/spola/app/engine.py:1363
msgid "Restoring from Koofr's trash…"
msgstr "Ripristino dal cestino di Koofr…"

#: src/spola/app/engine.py:1372
#, python-brace-format
msgid "Restoring from Koofr's trash: {n} of {total}"
msgstr "Ripristino dal cestino di Koofr: {n} di {total}"

#: src/spola/app/engine.py:1414
#, python-brace-format
msgid "Koofr could not be listed after the restore: {error}"
msgstr "Impossibile elencare Koofr dopo il ripristino: {error}"

#: src/spola/app/engine.py:1543 src/spola/app/engine.py:2215
#: src/spola/app/engine.py:2239
msgid "The exclusions changed"
msgstr "Le esclusioni sono cambiate"

#: src/spola/app/engine.py:1600
#, python-brace-format
msgid "“{name}” is no longer there."
msgstr "“{name}” non c'è più."

#: src/spola/app/engine.py:1663
#, python-brace-format
msgid "{n} conflict resolved: both versions are kept, renamed."
msgid_plural "{n} conflicts resolved: both versions are kept, renamed."
msgstr[0] "{n} conflitto risolto: restano entrambe le versioni, rinominate."
msgstr[1] "{n} conflitti risolti: restano entrambe le versioni, rinominate."

#: src/spola/app/engine.py:1666
#, python-brace-format
msgid ""
"{n} conflict resolved by the folder's rule: the version not kept is among "
"the folder's kept copies."
msgid_plural ""
"{n} conflicts resolved by the folder's rule: the versions not kept are among "
"the folder's kept copies."
msgstr[0] ""
"{n} conflitto risolto con la regola della cartella: la versione scartata è "
"tra le copie conservate della cartella."
msgstr[1] ""
"{n} conflitti risolti con la regola della cartella: le versioni scartate "
"sono tra le copie conservate della cartella."

#: src/spola/app/engine.py:1674
#, python-brace-format
msgid "{n} file was changed both here and on Koofr: both versions are kept."
msgid_plural ""
"{n} files were changed both here and on Koofr: both versions are kept."
msgstr[0] ""
"{n} file è cambiato sia qui sia su Koofr: restano entrambe le versioni."
msgstr[1] ""
"{n} file sono cambiati sia qui sia su Koofr: restano entrambe le versioni."

#: src/spola/app/engine.py:1749 src/spola/cli.py:238
#: src/spola/gui/window.py:333
msgid "rclone was not found."
msgstr "rclone non è stato trovato."

#: src/spola/app/engine.py:1765
msgid "Preparing…"
msgstr "Preparazione…"

#: src/spola/app/engine.py:1813
msgid "The public links on Koofr could not be checked. Spola tries again."
msgstr ""
"Non è stato possibile controllare i link pubblici su Koofr. Spola riprova."

#: src/spola/app/engine.py:1906
#, python-brace-format
msgid "Waiting for a file still being written: {name}"
msgstr "In attesa di un file ancora in scrittura: {name}"

#: src/spola/app/engine.py:1915 src/spola/cli.py:128
#, python-brace-format
msgid "{n} of {total} files changed on this computer at once"
msgstr "{n} file su {total} cambiati su questo computer tutti insieme"

#: src/spola/app/engine.py:1929
#, python-brace-format
msgid "“{name}” has a public link, which this sync would remove on Koofr"
msgstr ""
"«{name}» ha un link pubblico, che questa sincronizzazione toglierebbe su "
"Koofr"

#: src/spola/app/engine.py:1931
#, python-brace-format
msgid "{n} public links would be removed on Koofr by this sync"
msgstr "Questa sincronizzazione toglierebbe {n} link pubblici su Koofr"

#: src/spola/app/engine.py:1942
msgid "The record of the last synced state is damaged"
msgstr "Il registro dell'ultimo stato sincronizzato è danneggiato"

#: src/spola/app/engine.py:1972 src/spola/cli.py:151 src/spola/cli.py:341
msgid "This folder is being synced by another Spola process."
msgstr ""
"Questa cartella è già in sincronizzazione da un altro processo di Spola."

#: src/spola/app/engine.py:1998
msgid "Syncing with Koofr"
msgstr "Sincronizzazione con Koofr"

#: src/spola/app/engine.py:1999
msgid "Syncing…"
msgstr "Sincronizzazione…"

#: src/spola/app/engine.py:2118
#, python-brace-format
msgid "The outcome of the sync could not be read: {error}"
msgstr "Impossibile leggere l'esito della sincronizzazione: {error}"

#: src/spola/app/engine.py:2166
#, python-brace-format
msgid "{n} file is not synced: Koofr does not accept its name."
msgid_plural "{n} files are not synced: Koofr does not accept their names."
msgstr[0] "{n} file non è sincronizzato: Koofr non accetta il suo nome."
msgstr[1] "{n} file non sono sincronizzati: Koofr non accetta i loro nomi."

#: src/spola/app/engine.py:2256
msgid "The sync stopped with an error."
msgstr "La sincronizzazione si è fermata per un errore."

#: src/spola/app/engine.py:2260
#, python-brace-format
msgid "A previous sync was interrupted: trying again in {n} min."
msgstr ""
"Una sincronizzazione precedente è stata interrotta: riprovo tra {n} min."

#: src/spola/app/engine.py:2262
#, python-brace-format
msgid "Koofr cannot be reached right now: trying again in {n} min."
msgstr ""
"Koofr non è raggiungibile in questo momento: nuovo tentativo tra {n} min."

#: src/spola/app/engine.py:2268
#, python-brace-format
msgid ""
"Koofr is receiving too many requests: trying again in {n} min, more slowly."
msgstr ""
"Koofr sta ricevendo troppe richieste: riprovo tra {n} min, più lentamente."

#: src/spola/app/explorer.py:131
#, python-brace-format
msgid "Confirm the first alignment of “{name}” before sharing."
msgstr "Conferma il primo allineamento di «{name}» prima di condividere."

#: src/spola/app/explorer.py:139
msgid "The folder’s exclusions could not be read."
msgstr "Non è stato possibile leggere le esclusioni della cartella."

#: src/spola/app/explorer.py:141
msgid ""
"Sharing cannot check this folder’s exclusions because they contain "
"unsupported filter syntax. Open the item on Koofr to manage sharing."
msgstr ""
"Non è possibile verificare le esclusioni di questa cartella per la "
"condivisione: contengono una sintassi di filtro non supportata. Apri "
"l’elemento su Koofr per gestirne la condivisione."

#: src/spola/app/explorer.py:144
#, python-brace-format
msgid "“{name}” is not synced with Koofr: it has no share link."
msgstr ""
"«{name}» non è sincronizzato con Koofr: non ha un link di condivisione."

#. TRANSLATORS: goes into file names, e.g. report.conflict-local-2026-10-10-1.odt;
#. use letters and "-" only
#: src/spola/app/jobs.py:44 src/spola/app/jobs.py:47
msgid "conflict-local"
msgstr "conflitto-locale"

#: src/spola/app/jobs.py:44 src/spola/app/jobs.py:47
msgid "conflict-koofr"
msgstr "conflitto-koofr"

#: src/spola/app/jobs.py:549
#, python-brace-format
msgid "Could not rename “{old}” to “{new}” on Koofr: {error}"
msgstr "Non è stato possibile rinominare “{old}” in “{new}” su Koofr: {error}"

#: src/spola/app/migrate.py:54
msgid "already in Spola"
msgstr "già in Spola"

#: src/spola/app/migrate.py:57 src/spola/cli.py:317
msgid "Choose a folder on Koofr, not the whole Koofr storage."
msgstr "Scegli una cartella su Koofr, non tutto lo spazio di Koofr."

#: src/spola/app/migrate.py:74
msgid "not in your own Koofr storage (a shared folder or a connected service)"
msgstr ""
"non è nel tuo spazio Koofr (una cartella condivisa o un servizio collegato)"

#: src/spola/app/migrate.py:76
msgid ""
"Spola could not ask Koofr which storage is your own: try again when Koofr "
"can be reached"
msgstr ""
"Spola non è riuscito a chiedere a Koofr qual è il tuo spazio: riprova quando "
"Koofr è raggiungibile"

#: src/spola/app/migrate.py:101
msgid "Koofr Desktop is running or set to start at login: stop it first."
msgstr ""
"Koofr Desktop è in esecuzione o impostato per avviarsi all'accesso: prima "
"fermalo."

#: src/spola/app/preflight.py:69 src/spola/app/preflight.py:97
msgid "This folder contains your whole home folder: choose a folder inside it."
msgstr ""
"Questa cartella contiene tutta la tua cartella home: scegli una cartella al "
"suo interno."

#: src/spola/app/preflight.py:73 src/spola/app/preflight.py:101
msgid ""
"This folder holds settings and data of the system or of other apps and "
"cannot be synced."
msgstr ""
"Questa cartella contiene impostazioni e dati del sistema o di altre app e "
"non si può sincronizzare."

#: src/spola/app/preflight.py:79 src/spola/app/preflight.py:105
msgid ""
"Only folders inside your home folder or on removable drives can be synced."
msgstr ""
"Si possono sincronizzare solo cartelle dentro la tua home o su dischi "
"rimovibili."

#: src/spola/app/preflight.py:86
msgid "The folder path must be absolute."
msgstr "Il percorso della cartella deve essere assoluto."

#: src/spola/app/preflight.py:88
msgid "The folder is a symbolic link: choose the folder it points to."
msgstr ""
"La cartella è un collegamento simbolico: scegli la cartella a cui punta."

#: src/spola/app/preflight.py:91
msgid "The folder does not exist."
msgstr "La cartella non esiste."

#: src/spola/app/preflight.py:118
msgid "This folder overlaps with the folder of another pair."
msgstr "Questa cartella si sovrappone alla cartella di un'altra coppia."

#: src/spola/app/preflight.py:120
msgid "This Koofr folder overlaps with the Koofr folder of another pair."
msgstr ""
"Questa cartella di Koofr si sovrappone alla cartella di Koofr di un'altra "
"coppia."

#: src/spola/app/preflight.py:294
msgid ""
"Koofr Desktop is syncing this folder too: two sync engines on the same files "
"lose files. Quit Koofr Desktop and remove it from the programs started at "
"login, or remove this folder from it."
msgstr ""
"Anche Koofr Desktop sincronizza questa cartella: due programmi di "
"sincronizzazione sugli stessi file finiscono per perderli. Chiudi Koofr "
